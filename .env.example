# ============================================================================
# automeme configuration
# Copy this file to ".env" and fill in the values.
# NEVER commit your real .env file.
# ============================================================================

# --- Control panel security (REQUIRED) ---
# Password used to log in to the private control panel.
AUTOMEME_PANEL_PASSWORD=change-me-to-a-long-random-passphrase
# Secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTOMEME_SECRET_KEY=change-me-generate-a-random-secret

# --- Runtime mode ---
# When DRY_RUN=true, the system does EVERYTHING except actually publish to X.
# It records what it *would* have posted. Keep this true until you are ready.
AUTOMEME_DRY_RUN=true

# Bind address for the control panel.
AUTOMEME_HOST=127.0.0.1
AUTOMEME_PORT=8080

# Where images + database live.
AUTOMEME_DATA_DIR=./data

# --- X / Twitter API credentials (REQUIRED only to actually post) ---
# Create an app at https://developer.x.com with Read+Write permission,
# then generate OAuth 1.0a user tokens for the account you want to post from.
# Leave blank while DRY_RUN=true.
AUTOMEME_X_API_KEY=
AUTOMEME_X_API_SECRET=
AUTOMEME_X_ACCESS_TOKEN=
AUTOMEME_X_ACCESS_SECRET=
# Bearer token (OAuth2 app-only) is used for reading post metrics.
AUTOMEME_X_BEARER_TOKEN=

# --- Discover memes FROM X (Twitter) ---
# WARNING: X is pay-per-use. Every search request spends account credit.
# When true (and read credentials above exist), the curator also searches X for
# trending image tweets. Leave false to source only from Reddit (free).
AUTOMEME_X_DISCOVERY_ENABLED=false

# --- Reddit API (FREE, strongly recommended) ---
# Gives real post AGE so the bot catches memes while they're climbing and skips
# old ones that already went viral. Create a "script" app at:
#   https://www.reddit.com/prefs/apps
AUTOMEME_REDDIT_CLIENT_ID=
AUTOMEME_REDDIT_CLIENT_SECRET=

# --- Optional: AI captions (caption_mode="ai") ---
# Leave blank to use the built-in, no-cost caption generator (recommended).
# Set a key to use an OpenAI-compatible model instead. Generated captions are
# still humanized (short, lowercase, no AI tells) and safety-screened.
AUTOMEME_OPENAI_API_KEY=
AUTOMEME_OPENAI_BASE_URL=https://api.openai.com/v1
AUTOMEME_OPENAI_MODEL=gpt-4o-mini

# --- Discovery politeness ---
# A descriptive User-Agent is required by many public APIs (e.g. Reddit).
AUTOMEME_USER_AGENT=automeme/1.0 (autonomous meme curator; contact: you@example.com)
